<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Config for PrjPhotos
    ======================================
    This app is designed to connect to self-hosted servers on any network.
    Cleartext (HTTP) is allowed globally so that:
      • Local LAN servers (192.168.x.x, 10.x.x.x, etc.) work over plain HTTP
      • Servers with self-signed / private CA certificates work over HTTPS

    The OkHttpClient in ApiClient.kt additionally validates that cleartext
    is only used when the target resolves to a private/loopback address,
    keeping public-internet requests secure by default.

    Trust anchors include both system CAs and user-installed CAs so that
    self-signed certificates on local servers are accepted.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <!-- Trust system CAs (normal HTTPS sites) -->
            <certificates src="system" />
            <!-- Trust user-installed CAs (self-signed local server certs) -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
